{
  "name": "pdfcraft-video",
  "private": true,
  "version": "0.1.0",
  "description": "3D animated videos: Three.js (via React Three Fiber) for 3D, Remotion for captions, audio and rendering.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Main out/main.mp4",
    "still": "remotion still Main out/still.png --frame=60",
    "typecheck": "tsc --noEmit",
    "voice": "node scripts/voice.mjs",
    "voice:all": "node scripts/voice.mjs --episode ep1 && node scripts/voice.mjs --episode ep2 && node scripts/voice.mjs --episode ep3 && node scripts/voice.mjs --episode ep4 && node scripts/voice.mjs --episode ep5 && node scripts/voice.mjs --episode ep6",
    "render:ep1": "remotion render Ep1-HowPlanesFly out/ep1-how-planes-fly.mp4",
    "render:ep2": "remotion render Ep2-HowPlanesLand out/ep2-how-planes-land.mp4",
    "render:ep3": "remotion render Ep3-WhyFlySoHigh out/ep3-why-fly-so-high.mp4",
    "render:ep4": "remotion render Ep4-HowPilotsNavigate out/ep4-how-pilots-navigate.mp4",
    "render:ep5": "remotion render Ep5-WhatIsTurbulence out/ep5-what-is-turbulence.mp4",
    "render:ep6": "remotion render Ep6-InsideTheCockpit out/ep6-inside-the-cockpit.mp4"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "@remotion/three": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "react": "19.2",
    "react-dom": "19.2",
    "remotion": "^4.0.541",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "kokoro-js": "^1.2.1",
    "typescript": "^7.0.2"
  }
}
